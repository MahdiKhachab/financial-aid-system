<?xml version="1.0" encoding="UTF-8"?>
<!-- Application beans are Spring beans. Weld only serves Faces and OmniFaces, so it must not
     discover the application classes (that would create a second copy of every controller). -->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
	version="4.0" bean-discovery-mode="none">
</beans>
