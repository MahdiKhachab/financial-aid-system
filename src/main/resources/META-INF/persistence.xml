<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.0"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
	<!-- The DataSource is supplied by Spring (see boot.PersistenceConfig) -->
	<persistence-unit name="ShariaFunds-persistence-unit"
		transaction-type="RESOURCE_LOCAL">
		<description>Forge Persistence Unit</description>
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
		<class>cfg.model.CompanyCfg</class>
		<class>cfg.model.HealthyStatusCfg</class>
		<class>cfg.model.InssuranceCfg</class>
		<class>cfg.model.PoorPercentageCfg</class>
		<class>cfg.model.ReligionReferenceCfg</class>
		<class>cfg.model.SubmissionCfg</class>
		<class>cfg.model.SubmissionDetailsCfg</class>
		<class>org.model.MainEntity</class>
		<class>org.model.Deserved</class>
		<class>org.model.Sponsor</class>
		<class>org.model.ReceiveMoney</class>
		<class>org.model.Mediator</class>
		<class>org.model.ProvideAid</class>
		<class>org.model.ProvideAidRabet</class>
		<class>org.model.ProvideAidCompany</class>
		<class>org.model.ProvideAidDesrvedPerson</class>
		<class>org.model.Attachment</class>
		<class>org.model.Worker</class>
		<class>org.model.DeadNeed</class>
		<class>org.model.DeadPerson</class>
		<class>org.model.NeedDetails</class>
		<class>cfg.model.Service</class>
		<class>org.model.SubbmissionExchnage</class>
		<class>org.model.Stores</class>
		<class>org.model.PurchaseVoucherCoupon</class>
		<class>org.model.PurchaseVoucher</class>
		<exclude-unlisted-classes>false</exclude-unlisted-classes>
		<properties>
			
			<property name="eclipselink.deploy-on-startup" value="true" />
			<property name="eclipselink.logging.level.sql" value="FINE" />
			<property name="eclipselink.logging.parameters" value="true" />
			<property name="eclipselink.logging.parameters" value="true" />
			<property name="eclipselink.target-database"
				value="org.eclipse.persistence.platform.database.PostgreSQLPlatform" />
			<!-- Never create, alter or drop tables -->
			<property name="eclipselink.ddl-generation" value="none" />
			<!-- No Java agent on embedded Tomcat; no entity relies on woven lazy to-one fetching -->
			<property name="eclipselink.weaving" value="false" />


		</properties>
	</persistence-unit>
</persistence>
